# Copy to .env and fill in. .env is gitignored; this template is not.

# Private key used to deploy and to submit anchors. A dedicated key, not a personal wallet.
ANCHOR_DEPLOYER_KEY=

# Optional. Public endpoints are used when these are unset.
ARBITRUM_SEPOLIA_RPC_URL=
OP_SEPOLIA_RPC_URL=

# Set by `npm run test:gas`; no need to set it here.
REPORT_GAS=
