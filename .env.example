# Copy to .env and fill in. .env is gitignored; this template is not.

# Private key used to deploy and to submit anchors. A dedicated key, not a personal wallet.
ANCHOR_DEPLOYER_KEY=

# Optional. Public endpoints are used when these are unset.
ARBITRUM_SEPOLIA_RPC_URL=
OP_SEPOLIA_RPC_URL=
ZKSYNC_SEPOLIA_RPC_URL=
# L1 Sepolia RPC, used when bridging to zkSync Sepolia.
SEPOLIA_RPC_URL=

# Optional override for CI submit script when the manifest is absent.
GPA_PROJECT_ID=

# Optional space/comma-separated deployment names for scripts/submit-anchor.ts
GPA_NETWORKS=

# Set by `npm run test:gas`; no need to set it here.
REPORT_GAS=
